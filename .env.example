# Copier ce fichier en .env, puis adapter les valeurs.
# Le .env contient des secrets : il n'est jamais commité.

# Clé secrète Django
SECRET_KEY=ma clée
# True uniquement en développement. Vaut False si la variable est absente.
DEBUG=True

# Hôtes autorisés, séparés par des virgules.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL : le conteneur db crée la base avec ces valeurs.
POSTGRES_DB=tanafit
POSTGRES_USER=tanafit
POSTGRES_PASSWORD=mdp

# Connexion de Django à la base. "db" est le nom du service dans docker-compose.
# Le mot de passe doit être le même que POSTGRES_PASSWORD.
DATABASE_URL=postgres://tanafit:mdp@db:5432/tanafit